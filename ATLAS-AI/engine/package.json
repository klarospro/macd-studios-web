{
  "name": "atlas-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:deriv": "node --env-file=../.env.local --import tsx src/scripts/derivSmoke.ts",
    "backtest:tsmom": "node --import tsx src/backtest/runTsmomBacktest.ts",
    "backtest:multi": "node --import tsx src/backtest/runMultiTsmomBacktest.ts",
    "fetch:deriv": "node --env-file=../.env.local --import tsx src/scripts/fetchDerivHistory.ts",
    "cycle:daily": "node --env-file=../.env.local --import tsx src/live/dailyCycle.ts",
    "publish:live": "node --env-file=../.env.local --import tsx src/live/publishLive.ts",
    "export:account": "node --env-file=../.env.local --import tsx src/scripts/exportAccountData.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
