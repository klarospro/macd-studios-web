# Plantilla de variables de entorno de Atlas AI.
# Copia este archivo a .env.local y rellena los VALORES ahí (nunca aqui, nunca en el chat, nunca en git).
# .env.local esta ignorado por git y bloqueado por los hooks de escritura de secretos.

# --- Datos de mercado ---
COINGECKO_DEMO_KEY=            # key regenerada en el dashboard de CoinGecko

# --- Deriv (broker, cuenta DEMO) ---
DERIV_APP_ID=                  # app_id registrado en developers.deriv.com (no es secreto, pero va aqui por comodidad)
DERIV_API_TOKEN=               # token con scope MINIMO (read + trade). NUNCA payments/admin
DERIV_MT5_SERVER=Deriv-Demo    # identificador, no secreto

# --- Exchange cripto (TESTNET, dinero ficticio) ---
BINANCE_TESTNET_KEY=           # regenerada en testnet.binance.vision
BINANCE_TESTNET_SECRET=        # el secret solo se muestra una vez al crearla

# --- Supabase (proyecto Atlas separado; aun por crear) ---
SUPABASE_PROJECT_REF=          # ref del proyecto (sustituye <PROJECT_REF> en .mcp.json)
SUPABASE_ACCESS_TOKEN=         # PAT con alcance minimo (idealmente solo el proyecto Atlas)
