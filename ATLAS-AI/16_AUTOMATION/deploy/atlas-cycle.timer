# Atlas AI — dispara el ciclo diario una vez al día.
# La estrategia usa velas DIARIAS (granularity 86400); las señales solo cambian al
# cerrar la vela (00:00 UTC). Corremos a las 00:05 UTC para dar margen a que la vela
# se finalice en Deriv antes de recalcular.
#
# Instalar en: /etc/systemd/system/atlas-cycle.timer
# Activar con:  systemctl enable --now atlas-cycle.timer

[Unit]
Description=Atlas AI - timer del ciclo diario (00:05 UTC)

[Timer]
OnCalendar=*-*-* 00:05:00 UTC
# Si el VPS estaba apagado a esa hora, corre en cuanto arranque (no perder el día).
Persistent=true
# Pequeño jitter para no clavar exactamente el mismo segundo en cada arranque.
RandomizedDelaySec=60
Unit=atlas-cycle.service

[Install]
WantedBy=timers.target
