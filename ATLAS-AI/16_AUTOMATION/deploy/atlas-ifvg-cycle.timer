# Atlas AI — dispara el ciclo PAPER de ICT IFVG cada 5 minutos, todo el día.
# La estrategia entra solo en la ventana 9:30-10:10 NY, pero gestiona la posición abierta
# (TP1/TP2/break-even/kill-switch) el resto del día natural — por eso corre 24/7, no solo
# durante la ventana (el propio script hace no-op fuera de horario cuando está flat).
#
# Instalar en: /etc/systemd/system/atlas-ifvg-cycle.timer
# Activar con:  systemctl enable --now atlas-ifvg-cycle.timer

[Unit]
Description=Atlas AI - timer del ciclo PAPER de ICT IFVG (cada 5 min)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=atlas-ifvg-cycle.service

[Install]
WantedBy=timers.target
