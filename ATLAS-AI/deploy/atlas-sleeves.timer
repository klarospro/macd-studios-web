# Dispara el ciclo multi-sleeve cada 5 minutos.
#
# Por qué 5 minutos y no 1: el Sleeve B trabaja sobre velas M5, así que más
# frecuencia no aporta información nueva. El Core se autolimita a una revisión
# diaria (opera velas diarias). El Sleeve C tiene una ventana de entrada de
# 60-120 s tras el dato macro — con 5 minutos puede perderse alguna; cuando se
# carguen eventos reales en `eventscalp.sorpresa.eventos_programados`, bajar a
# OnUnitActiveSec=1min los días con dato.
#
# Instalar en: /etc/systemd/system/atlas-sleeves.timer

[Unit]
Description=Dispara el ciclo multi-sleeve de Atlas cada 5 minutos

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Sin persistencia: si el VPS estuvo caído, no tiene sentido recuperar pasadas
# atrasadas — sus precios ya no existen.
Persistent=false
AccuracySec=15s
Unit=atlas-sleeves.service

[Install]
WantedBy=timers.target
